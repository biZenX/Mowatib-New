# ==============================================================================
# Mowatib (مواظب) - Environment Variables Configuration
# Copy this file to .env and fill in your Supabase credentials
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Web Push VAPID Public Key for Remote Push Notifications
VITE_VAPID_PUBLIC_KEY=

# Application Environment
VITE_APP_ENV=development
